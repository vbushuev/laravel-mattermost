{
    "name": "vbushuev/laravel-mattermost",
    "description": "Laravel logging package for Mattermost webhooks",
    "type": "laravel-package",
    "license": "MIT",
    "authors": [
        {
            "name": "Vladimir Bushuev",
            "email": "v.bushuev@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0|^12.0|^13.0",
        "monolog/monolog": "^2.0|^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "mockery/mockery": "^1.4"
    },
    "autoload": {
        "psr-4": {
            "Bushuev\\Mattermost\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bushuev\\Mattermost\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
